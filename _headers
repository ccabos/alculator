# Cloudflare static-asset headers.
# The service worker and the HTML entry point must always be revalidated so
# that a bumped CACHE_VERSION in sw.js reaches users promptly. All other assets
# are versioned through the service-worker cache.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
